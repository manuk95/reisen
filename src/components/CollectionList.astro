---
const {items,section}=Astro.props;const base=import.meta.env.BASE_URL;
---
<div class="grid">{items.map((x:any)=><article class="card"><span class:list={['badge',x.data.status==='fix'&&'fix']}>{x.data.status.replaceAll('-',' ')}</span><h2><a href={`${base}georgien/${section}/${x.data.slug}/`}>{x.data.title}</a></h2><p>{x.data.summary}</p><p class="meta">{x.data.region}{x.data.days.length?` · ${x.data.days.join(', ')}`:''}</p></article>)}</div>
