---
const {items,section,showStatus=true}=Astro.props;const base=import.meta.env.BASE_URL;
---
<div class="grid">{items.map((x:any)=>{const image=x.data.image?.includes('georgische-flagge')?'images/platzhalter.png':x.data.image||'images/platzhalter.png';const alt=image==='images/platzhalter.png'?`Platzhalterbild für ${x.data.title}`:x.data.imageAlt;return <article class="card"><img class="card-image" src={`${base}${image}`} alt={alt} loading="lazy" decoding="async"/>{showStatus&&<span class:list={['badge',x.data.status==='fix'&&'fix']}>{x.data.status.replaceAll('-',' ')}</span>}<h2><a href={`${base}georgien/${section}/${x.data.slug}/`}>{x.data.title}</a></h2><p>{x.data.summary}</p><p class="meta">{x.data.region}</p></article>})}</div>
