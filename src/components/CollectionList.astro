---
const {items,section,showImage=true,showStatus=true}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<div class="grid">
  {items.map((x:any)=>{
    const primary=x.data.images?.[0];
    const image=primary?.src||x.data.image||'images/platzhalter.png';
    const alt=primary?.alt||x.data.imageAlt||`Neutrales Platzhalterbild für ${x.data.title}`;
    const isContext=(primary?.edit||x.data.imageEdit)?.startsWith('Kontextbild:');
    return <article class="card">
      {showImage&&<img class="card-image" src={`${base}${image}`} alt={alt} loading="lazy" decoding="async"/>}
      {showImage&&isContext&&<p class="meta"><strong>Kontextbild</strong> · zeigt nicht den Betrieb selbst</p>}
      {showImage&&(primary?.credit||x.data.imageCredit)&&<p class="meta">Bild: {(primary?.source||x.data.imageSource)?<a href={primary?.source||x.data.imageSource} rel="external noopener noreferrer" target="_blank">{primary?.credit||x.data.imageCredit}</a>:(primary?.credit||x.data.imageCredit)}{(primary?.license||x.data.imageLicense)&&<> · {primary?.license||x.data.imageLicense}</>}</p>}
      {showStatus&&<span class:list={['badge',x.data.status==='fix'&&'fix']}>{x.data.status.replaceAll('-',' ')}</span>}
      <h2><a href={`${base}georgien/${section}/${x.data.slug}/`}>{x.data.title}</a></h2>
      <p>{x.data.summary}</p>
      <p class="meta">{x.data.region}</p>
    </article>
  })}
</div>
