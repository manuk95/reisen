---
import {getCollection} from 'astro:content';const {days=[]}=Astro.props;const base=import.meta.env.BASE_URL;const entries=(await getCollection('reisetage')).filter(d=>days.includes(d.data.slug)).sort((a,b)=>a.data.day-b.data.day);
---
{entries.length>0&&<nav class="day-links" aria-label="Zugehörige Reisetage"><h2>Im Tagesprogramm</h2><ul>{entries.map(d=><li><a href={`${base}georgien/tag/${d.data.slug}/`}>Tag {d.data.day} – {d.data.character}</a></li>)}</ul></nav>}
