---
import Base from '../../layouts/Base.astro';import {getEntry,getCollection} from 'astro:content';const trip=await getEntry('reisen','georgien-2026');const days=(await getCollection('reisetage')).sort((a,b)=>a.data.day-b.data.day);const {Content}=await trip!.render();const base=import.meta.env.BASE_URL;
---
<Base title="Georgien 2026"><section class="hero"><div><p class="eyebrow">28. September – 11. Oktober · 14 Tage</p><h1>Georgien 2026</h1><p>Kaukasus, Kultur, Wein und Schwarzes Meer.</p><div class="actions"><a href={`${base}georgien/heute/`}>Heute</a><a class="secondary" href={`${base}georgien/reiseplan/`}>Alle Tage</a><a class="secondary" href={`${base}georgien/karte/`}>Route</a></div><p id="countdown" aria-live="polite"></p></div><img src={`${base}images/georgia-route.svg`} alt="Schematische Reiseroute"></section><div class="wrap"><div class="grid"><article class="card"><p class="eyebrow">Route</p><h2>Sieben feste Stationen</h2><p>{trip!.data.route.join(' → ')}</p></article><article class="card"><p class="eyebrow">Fix gebucht</p><h2>Flüge</h2><p><strong>28.09. · 09:30</strong> Zürich → Tbilisi, Ankunft 18:20</p><p><strong>10.10. · 22:40</strong> Batumi → Zürich, Ankunft 11.10. um 09:55</p></article><article class="card"><p class="eyebrow">Noch offen</p><h2>Buchungen</h2><p>Hotels, Mietwagen, Bergfahrer, Schwefelbad, Weingut sowie der Umgang mit dem extremen Vardzia-Fahrtag.</p></article><article class="card"><p class="eyebrow">Budget-Richtwert</p><h2>Preise zeitabhängig</h2><p>Zimmer meist CHF 40–125, Küstenluxus CHF 140–380+ pro Nacht. Sämtliche Endpreise neu prüfen.</p></article></div><aside class="alert"><strong>Pass erneuern:</strong> Der im November 2026 ablaufende Reisepass unterschreitet die publizierte Sechsmonatsregel. <a href={`${base}georgien/praktisches/einreise/`}>Einreisecheck öffnen</a>.</aside><h2>Reiseführer</h2><div class="actions"><a href={`${base}georgien/praktisches/sicherheit/`}>Notfall 112</a><a class="secondary" href={`${base}georgien/hotels/`}>Hotels vergleichen</a><a class="secondary" href={`${base}georgien/genuss/`}>Essen entdecken</a></div><article class="prose"><Content /></article></div><script is:inline>const a=new Date('2026-09-28T00:00:00+04:00'),b=new Date('2026-10-12T00:00:00+04:00'),n=new Date(),e=document.querySelector('#countdown');if(n<a)e.textContent=`Noch ${Math.ceil((a-n)/864e5)} Tage bis zur Abreise.`;else if(n<b)e.textContent=`Reisetag ${Math.min(14,Math.floor((n-a)/864e5)+1)} von 14.`;else e.textContent='Reiserückblick · 14 Tage Georgien.';</script></Base>
