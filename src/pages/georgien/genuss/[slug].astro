---
import Base from '../../../layouts/Base.astro';import {getCollection} from 'astro:content';export async function getStaticPaths(){return (await getCollection('genuss')).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}const {entry}=Astro.props;const {Content}=await entry.render();const base=import.meta.env.BASE_URL;
---
<Base title={entry.data.title}><div class="wrap"><p><a href={`${base}georgien/`}>Georgien</a> / <a href={`${base}georgien/genuss/`}>Essen & Getränke</a></p><span class="badge">{entry.data.status.replaceAll('-',' ')}</span><h1>{entry.data.title}</h1><p class="meta">{entry.data.region} · Stand {entry.data.updated.toLocaleDateString('de-CH')}</p><p class="lead">{entry.data.summary}</p><article class="prose"><Content /></article>{entry.data.days.length>0&&<aside class="alert"><strong>Reisetage:</strong> {entry.data.days.join(', ')}</aside>}<h2>Quellen</h2><ul>{entry.data.sources.map((s:any)=><li><a href={s.url} rel="external">{s.label}</a></li>)}</ul></div></Base>