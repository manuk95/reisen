---
import Base from '../../layouts/Base.astro';import List from '../../components/CollectionList.astro';import {getCollection} from 'astro:content';const items=await getCollection('wissen');const base=import.meta.env.BASE_URL;
---
<Base title="Wissen über Georgien"><div class="wrap"><p class="eyebrow">Georgien 2026</p><h1>Wissen über Georgien</h1><p class="lead">Land, Gesellschaft, Geschichte, Kultur, Sprache und praktische Reisehinweise – ohne Kapitelnummern aus dem Arbeitsdokument.</p><div class="actions"><a href={`${base}georgien/wissen/praktisches/`}>Praktisches</a><a class="secondary" href={`${base}georgien/wissen/packliste/`}>Packliste</a></div><List {items} section="wissen" showImage={false} showStatus={false} /></div></Base>
