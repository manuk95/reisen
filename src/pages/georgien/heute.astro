---
// @ts-nocheck
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';const days=(await getCollection('reisetage')).sort((a,b)=>a.data.day-b.data.day);const base=import.meta.env.BASE_URL;
---
<Base title="Heute"><div class="wrap"><p class="eyebrow">Georgien-Zeit · UTC+4</p><h1>Heute</h1><p id="today">Der passende Tag wird lokal auf deinem Gerät ermittelt.</p><label for="manual"><strong>Reisetag manuell wählen</strong></label><select id="manual"><option value="">Automatisch</option>{days.map(d=><option value={d.data.day}>Tag {d.data.day} · {d.data.from}–{d.data.to}</option>)}</select><div id="daycards" class="grid">{days.map(d=><article class="card" data-day={d.data.day} hidden><span class="badge">Tag {d.data.day}</span><h2>{d.data.title}</h2><p>{d.data.character}</p><a class="button" href={`${base}georgien/tag/${d.data.slug}/`}>Tagesplan öffnen</a></article>)}</div></div><script is:inline>const start=Date.parse('2026-09-28T00:00:00+04:00'),end=Date.parse('2026-10-12T00:00:00+04:00'),sel=document.querySelector('#manual'),label=document.querySelector('#today');function show(manual){let now=Date.now(),day=manual||Math.floor((now-start)/864e5)+1;if(day<1){label.textContent='Die Reise beginnt am 28. September 2026.';day=1}else if(day>14){label.textContent='Die Reise ist abgeschlossen – hier beginnt der Rückblick.';day=14}else label.textContent=`Reisetag ${day} von 14.`;document.querySelectorAll('[data-day]').forEach(x=>x.hidden=+x.dataset.day!==+day)}sel.addEventListener('change',()=>show(+sel.value));show(0);</script></Base>
