---
import Base from '../../layouts/Base.astro';
---
<Base title="Karte und in der Nähe">
  <div class="wrap">
    <p class="eyebrow">Route · Etappen · Orte</p>
    <h1>Karte</h1>
    <aside class="alert"><strong>Online-Hinweis:</strong> Kartenkacheln benötigen Internet und werden nicht offline vorab gespeichert. Koordinaten und Einträge bleiben verfügbar.</aside>
    <div class="filters" aria-label="Kartenfilter"><button data-filter="all">Alle</button><button data-filter="place">Orte</button><button data-filter="sight">Sehenswürdigkeiten</button><button data-filter="hotel">Unterkunft</button><button data-filter="airport">Flughäfen</button></div>
    <div id="map" class="map" aria-label="Interaktive Karte der Georgienroute"></div>
    <section>
      <h2>In der Nähe</h2>
      <p>Dein Standort wird erst nach Betätigung erfragt, nur lokal zur Distanzberechnung verwendet und weder gespeichert noch übertragen.</p>
      <div class="filters"><button id="locate">Standort verwenden</button><button data-radius="0.5">500 m</button><button data-radius="2">2 km</button><button data-radius="10">10 km</button><button data-radius="999">Entlang der Route</button></div>
      <p id="geo-status" role="status">Standort nicht angefragt.</p>
      <ol id="nearby"></ol>
    </section>
    <noscript>Ohne JavaScript ist die Karte nicht interaktiv. Alle Koordinaten stehen auf den redaktionellen Ortsseiten.</noscript>
  </div>
  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';
    import { points } from '../../data/route';

    type RoutePoint = (typeof points)[number];
    type PointType = RoutePoint['type'] | 'all';
    type Position = [number, number];

    const map = L.map('map', { scrollWheelZoom: false }).setView([42.1, 43.2], 7);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors', maxZoom: 19 }).addTo(map);
    const layer = L.layerGroup().addTo(map);
    const line = L.polyline(points.map((point) => [point.lat, point.lon]), { color: '#8d2438', weight: 4 }).addTo(map);
    map.fitBounds(line.getBounds(), { padding: [20, 20] });

    function draw(filter: PointType = 'all') {
      layer.clearLayers();
      points
        .filter((point) => filter === 'all' || point.type === filter)
        .forEach((point) => L.circleMarker([point.lat, point.lon], { radius: 9, color: '#fff', weight: 2, fillColor: point.type === 'airport' ? '#8d2438' : '#173f35', fillOpacity: 1 })
          .bindPopup(`<strong>${point.name}</strong><br>${point.lat}, ${point.lon}`)
          .addTo(layer));
    }

    draw();
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => button.addEventListener('click', () => draw((button.dataset.filter ?? 'all') as PointType)));

    let user: Position | undefined;
    let radius = 10;
    const out = document.querySelector<HTMLOListElement>('#nearby');
    const status = document.querySelector<HTMLParagraphElement>('#geo-status');
    const locate = document.querySelector<HTMLButtonElement>('#locate');

    function km(a: number, b: number, c: number, d: number) {
      const radians = Math.PI / 180;
      const x = (c - a) * radians;
      const y = (d - b) * radians;
      const q = Math.sin(x / 2) ** 2 + Math.cos(a * radians) * Math.cos(c * radians) * Math.sin(y / 2) ** 2;
      return 12742 * Math.asin(Math.sqrt(q));
    }

    function list() {
      const currentUser = user;
      if (!currentUser || !out) return;
      const found = points
        .map((point) => ({ ...point, d: km(currentUser[0], currentUser[1], point.lat, point.lon) }))
        .filter((point) => point.d <= radius)
        .sort((a, b) => a.d - b.d);
      out.innerHTML = found.length
        ? found.map((point) => `<li><strong>${point.name}</strong> · ${point.d.toFixed(1)} km</li>`).join('')
        : '<li>In diesem Radius liegt kein erfasster Eintrag.</li>';
    }

    locate?.addEventListener('click', () => {
      if (!status) return;
      if (!navigator.geolocation) {
        status.textContent = 'Standortfunktion wird von diesem Browser nicht unterstützt.';
        return;
      }
      status.textContent = 'Standort wird angefragt …';
      navigator.geolocation.getCurrentPosition(
        (position) => {
          user = [position.coords.latitude, position.coords.longitude];
          status.textContent = 'Standort nur lokal empfangen. Keine Übertragung oder Speicherung.';
          L.circleMarker(user, { radius: 10, color: '#ad7d26' }).addTo(map).bindPopup('Dein Standort');
          list();
        },
        (error) => {
          status.textContent = error.code === 1
            ? 'Standort nicht freigegeben. Die Route kann weiterhin ohne Standort genutzt werden.'
            : 'Standort konnte nicht ermittelt werden. Bitte später erneut versuchen.';
        },
        { timeout: 10000 },
      );
    });

    document.querySelectorAll<HTMLButtonElement>('[data-radius]').forEach((button) => button.addEventListener('click', () => {
      radius = Number(button.dataset.radius ?? radius);
      list();
    }));
  </script>
</Base>
