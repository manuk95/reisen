---
// @ts-nocheck
import Base from '../../layouts/Base.astro';import {points} from '../../data/route';
---
<Base title="Karte und in der Nähe"><div class="wrap"><p class="eyebrow">Route · Etappen · Orte</p><h1>Karte</h1><aside class="alert"><strong>Online-Hinweis:</strong> Kartenkacheln benötigen Internet und werden nicht offline vorab gespeichert. Koordinaten und Einträge bleiben verfügbar.</aside><div class="filters" aria-label="Kartenfilter"><button data-filter="all">Alle</button><button data-filter="place">Orte</button><button data-filter="sight">Sehenswürdigkeiten</button><button data-filter="hotel">Unterkunft</button><button data-filter="airport">Flughäfen</button></div><div id="map" class="map" aria-label="Interaktive Karte der Georgienroute"></div><section><h2>In der Nähe</h2><p>Dein Standort wird erst nach Betätigung erfragt, nur lokal zur Distanzberechnung verwendet und weder gespeichert noch übertragen.</p><div class="filters"><button id="locate">Standort verwenden</button><button data-radius="0.5">500 m</button><button data-radius="2">2 km</button><button data-radius="10">10 km</button><button data-radius="999">Entlang der Route</button></div><p id="geo-status" role="status">Standort nicht angefragt.</p><ol id="nearby"></ol></section><noscript>Ohne JavaScript ist die Karte nicht interaktiv. Alle Koordinaten stehen auf den redaktionellen Ortsseiten.</noscript></div><script>// @ts-nocheck
import L from 'leaflet';import 'leaflet/dist/leaflet.css';import {points} from '../../data/route';const map=L.map('map',{scrollWheelZoom:false}).setView([42.1,43.2],7);L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors',maxZoom:19}).addTo(map);const layer=L.layerGroup().addTo(map);const line=L.polyline(points.map(p=>[p.lat,p.lon]),{color:'#8d2438',weight:4}).addTo(map);map.fitBounds(line.getBounds(),{padding:[20,20]});function draw(f='all'){layer.clearLayers();points.filter(p=>f==='all'||p.type===f).forEach(p=>L.circleMarker([p.lat,p.lon],{radius:9,color:'#fff',weight:2,fillColor:p.type==='airport'?'#8d2438':'#173f35',fillOpacity:1}).bindPopup(`<strong>${p.name}</strong><br>${p.lat}, ${p.lon}`).addTo(layer))}draw();document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>draw(b.dataset.filter)));let user,radius=10;const out=document.querySelector('#nearby'),status=document.querySelector('#geo-status');function km(a,b,c,d){const r=Math.PI/180,x=(c-a)*r,y=(d-b)*r,q=Math.sin(x/2)**2+Math.cos(a*r)*Math.cos(c*r)*Math.sin(y/2)**2;return 12742*Math.asin(Math.sqrt(q))}function list(){if(!user)return;const found=points.map(p=>({...p,d:km(user[0],user[1],p.lat,p.lon)})).filter(p=>p.d<=radius).sort((a,b)=>a.d-b.d);out.innerHTML=found.length?found.map(p=>`<li><strong>${p.name}</strong> · ${p.d.toFixed(1)} km</li>`).join(''):'<li>In diesem Radius liegt kein erfasster Eintrag.</li>'}document.querySelector('#locate').addEventListener('click',()=>{if(!navigator.geolocation){status.textContent='Standortfunktion wird von diesem Browser nicht unterstützt.';return}status.textContent='Standort wird angefragt …';navigator.geolocation.getCurrentPosition(p=>{user=[p.coords.latitude,p.coords.longitude];status.textContent='Standort nur lokal empfangen. Keine Übertragung oder Speicherung.';L.circleMarker(user,{radius:10,color:'#ad7d26'}).addTo(map).bindPopup('Dein Standort');list()},e=>{status.textContent=e.code===1?'Standort nicht freigegeben. Die Route kann weiterhin ohne Standort genutzt werden.':'Standort konnte nicht ermittelt werden. Bitte später erneut versuchen.'},{timeout:10000})});document.querySelectorAll('[data-radius]').forEach(b=>b.addEventListener('click',()=>{radius=+b.dataset.radius;list()}));</script></Base>
