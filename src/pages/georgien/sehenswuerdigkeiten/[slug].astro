---
import Base from '../../../layouts/Base.astro';import ItemGallery from '../../../components/ItemGallery.astro';import DayLinks from '../../../components/DayLinks.astro';import RelatedLinks from '../../../components/RelatedLinks.astro';import {getCollection,render} from 'astro:content';import {requireRegion} from '../../../lib/regions.mjs';
export async function getStaticPaths(){return (await getCollection('sehenswuerdigkeiten')).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}const {entry}=Astro.props;const {Content}=await render(entry);const base=import.meta.env.BASE_URL,routeRoot=`${base}georgien/`;
const [places,sights]=await Promise.all([getCollection('orte'),getCollection('sehenswuerdigkeiten')]);const trip=(x:any)=>x.data.trip===entry.data.trip;const relation=(x:any)=>entry.data.related.includes(x.data.slug)||x.data.related.includes(entry.data.slug);const region=(x:any)=>requireRegion(x.data.region)===requireRegion(entry.data.region);
const ancestors:any[]=[];const seen=new Set([entry.data.slug]);let parent=entry.data.parent;while(parent){const ancestor=sights.find(x=>x.data.slug===parent&&trip(x));if(!ancestor||seen.has(parent))throw new Error(`Ungültige Breadcrumb-Hierarchie bei ${entry.data.slug}: ${parent}`);ancestors.unshift(ancestor);seen.add(parent);parent=ancestor.data.parent;}
const linkedPlaces=places.filter(x=>trip(x)&&(relation(x)||region(x)));const linkedSights=sights.filter(x=>x.id!==entry.id&&trip(x)&&(relation(x)||region(x)));
---
<Base title={entry.data.title} description={entry.data.summary}><div class="wrap"><nav aria-label="Breadcrumb"><p><a href={`${base}georgien/`}>Georgien</a> / <a href={`${routeRoot}sehenswuerdigkeiten/`}>Sehenswürdigkeiten</a>{ancestors.map(x=><> / <a href={`${routeRoot}sehenswuerdigkeiten/${x.data.slug}/`}>{x.data.title}</a></>)} / <span aria-current="page">{entry.data.title}</span></p></nav>{!entry.data.categories.includes('hintergrund')&&<span class="badge">{entry.data.status.replaceAll('-',' ')}</span>}<h1>{entry.data.title}</h1><p class="meta">{entry.data.region} · Stand {entry.data.updated.toLocaleDateString('de-CH')}</p><ItemGallery title={entry.data.title} images={entry.data.images} legacy={{src:entry.data.image,alt:entry.data.imageAlt||`Neutrales Platzhalterbild für ${entry.data.title}`,credit:entry.data.imageCredit,source:entry.data.imageSource,license:entry.data.imageLicense,edit:entry.data.imageEdit}} /><p class="lead">{entry.data.summary}</p><article class="prose"><Content /></article><DayLinks days={entry.data.days}/><RelatedLinks title="Orte in der Region" items={linkedPlaces} section="orte" {routeRoot}/><RelatedLinks title="Verwandte Sehenswürdigkeiten" items={linkedSights} section="sehenswuerdigkeiten" {routeRoot}/><p><a href={`${routeRoot}karte/`}>Auf der Reisekarte öffnen →</a></p><h2>Quellen</h2><ul>{entry.data.sources.map((s:any)=><li><a href={s.url} rel="external noopener noreferrer" target="_blank">{s.label}</a></li>)}</ul></div></Base>
