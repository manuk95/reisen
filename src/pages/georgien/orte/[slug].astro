---
import Base from '../../../layouts/Base.astro';import ItemGallery from '../../../components/ItemGallery.astro';import DayLinks from '../../../components/DayLinks.astro';import RelatedLinks from '../../../components/RelatedLinks.astro';import {getCollection,render} from 'astro:content';import {relatedForPlace} from '../../../lib/content-links.mjs';
export async function getStaticPaths(){return (await getCollection('orte')).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}
const {entry}=Astro.props;const {Content}=await render(entry);const base=import.meta.env.BASE_URL,routeRoot=`${base}georgien/`;
const [sights,restaurants,hotels,days]=await Promise.all([getCollection('sehenswuerdigkeiten'),getCollection('restaurants'),getCollection('unterkuenfte'),getCollection('reisetage')]);
const raw=(x:any)=>({title:x.data.title,slug:x.data.slug,trip:x.data.trip,region:x.data.region,status:x.data.status,days:x.data.days,related:x.data.related});const links=relatedForPlace(raw(entry),{sights:sights.map(raw),restaurants:restaurants.map(raw),hotels:hotels.map(raw),days:days.map(raw)});
const pick=(all:any[],linked:any[])=>all.filter(x=>linked.some(y=>y.slug===x.data.slug));
---
<Base title={entry.data.title}><div class="wrap"><p><a href={`${base}georgien/`}>Georgien</a> / <a href={`${routeRoot}orte/`}>Orte & Regionen</a></p><span class="badge">{entry.data.status.replaceAll('-',' ')}</span><h1>{entry.data.title}</h1><p class="meta">{entry.data.region} · Stand {entry.data.updated.toLocaleDateString('de-CH')}</p><ItemGallery title={entry.data.title} images={entry.data.images} legacy={{src:entry.data.image,alt:entry.data.imageAlt||`Neutrales Platzhalterbild für ${entry.data.title}`,credit:entry.data.imageCredit,source:entry.data.imageSource,license:entry.data.imageLicense,edit:entry.data.imageEdit}} /><p class="lead">{entry.data.summary}</p><article class="prose"><Content /></article><DayLinks days={entry.data.days} /><RelatedLinks title="Sehenswürdigkeiten" items={pick(sights,links.sights)} section="sehenswuerdigkeiten" {routeRoot}/><RelatedLinks title="Restaurants" items={pick(restaurants,links.restaurants)} section="restaurants" {routeRoot}/><RelatedLinks title="Unterkünfte" items={pick(hotels,links.hotels)} section="hotels" {routeRoot}/><p><a href={`${routeRoot}karte/`}>Auf der Reisekarte öffnen →</a></p><h2>Quellen</h2><ul>{entry.data.sources.map((s:any)=><li><a href={s.url} rel="external noopener noreferrer" target="_blank">{s.label}</a></li>)}</ul></div></Base>
