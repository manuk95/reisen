---
import Base from '../../../layouts/Base.astro';import DayLinks from '../../../components/DayLinks.astro';import {getCollection,render} from 'astro:content';export async function getStaticPaths(){return (await getCollection('orte')).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}const {entry}=Astro.props;const {Content}=await render(entry);const base=import.meta.env.BASE_URL;
---
<Base title={entry.data.title}><div class="wrap"><p><a href={`${base}georgien/`}>Georgien</a> / <a href={`${base}georgien/orte/`}>Orte</a></p><span class="badge">{entry.data.status.replaceAll('-',' ')}</span><h1>{entry.data.title}</h1><p class="meta">{entry.data.region} · Stand {entry.data.updated.toLocaleDateString('de-CH')}</p>{entry.data.image&&<img class="item-image" src={`${base}${entry.data.image}`} alt={entry.data.imageAlt} loading="lazy" decoding="async"/>}<p class="lead">{entry.data.summary}</p><article class="prose"><Content /></article><DayLinks days={entry.data.days} /><h2>Quellen</h2><ul>{entry.data.sources.map((s:any)=><li><a href={s.url} rel="external noopener noreferrer" target="_blank">{s.label}</a></li>)}</ul>{entry.data.imageCredit&&<p class="meta">Bild: <a href={entry.data.imageCredit.originalUrl} target="_blank" rel="noopener noreferrer">{entry.data.imageCredit.creator}</a> · {entry.data.imageCredit.license} · {entry.data.imageCredit.edited} · abgerufen {entry.data.imageCredit.accessed.toLocaleDateString('de-CH')}</p>}</div></Base>
