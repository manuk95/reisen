---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const days = (await getCollection('reisetage')).filter(day => day.data.trip === 'georgien-2026').sort((a, b) => a.data.day - b.data.day);
const base = import.meta.env.BASE_URL;
---
<Base title="Reiseplan Georgien">
  <div class="wrap">
    <p class="eyebrow">14 Reisetage</p>
    <h1>Reiseplan</h1>
    <p>Alle Tage sind chronologisch geplant; optionale Punkte, Schlechtwettervarianten und Kürzungen stehen direkt im jeweiligen Tagesplan.</p>

    <div class="alert">
      <strong>Mietwagen oder Fahrer?</strong> Die langen Transfers und Bergstrassen sind separat bewertet. <a href={`${base}georgien/fahrten/`}>Fahrten & Strassen →</a>
    </div>

    <div class="grid">
      {days.map(d => <article class="card">
        <span class="badge">Tag {d.data.day}</span>
        <h2><a href={`${base}georgien/tag/${d.data.slug}/`}>{d.data.date.toLocaleDateString('de-CH', { weekday: 'long', day: 'numeric', month: 'long' })}</a></h2>
        <p><strong>{d.data.from} → {d.data.to}</strong></p>
        <p>{d.data.character}</p>
      </article>)}
    </div>
  </div>
</Base>
