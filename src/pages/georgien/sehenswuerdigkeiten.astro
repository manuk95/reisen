---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';const items=await getCollection('sehenswuerdigkeiten');const base=import.meta.env.BASE_URL;const order=['Tbilisi','Mtskheta-Mtianeti','Shida Kartli','Samtskhe-Dschawachetien','Imeretien','Gurien','Adscharien','Samegrelo und Swanetien','Ratscha','Kachetien','Kvemo Kartli','Abchasien und Südossetien'];const regions=[...order,...new Set(items.map(x=>x.data.region).filter(x=>!order.includes(x)))];const id=(x:string)=>x.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-');
---
<Base title="Sehenswürdigkeiten nach Regionen"><div class="wrap"><p><a href={`${base}georgien/`}>Georgien</a> / Sehenswürdigkeiten</p><h1>Sehenswürdigkeiten nach Regionen</h1><p class="lead">Die Reihenfolge folgt der regionalen Gliederung der Reiseplanung; Ziele der Route stehen innerhalb der vorhandenen Einträge zuerst.</p><nav class="region-menu" aria-label="Regionen">{regions.map(r=><a href={`#${id(r)}`}>{r}</a>)}</nav>{regions.map(region=>{const xs=items.filter(x=>x.data.region===region).sort((a,b)=>(a.data.status==='nicht-auf-route'?1:0)-(b.data.status==='nicht-auf-route'?1:0));return xs.length>0&&<section id={id(region)}><h2>{region}</h2><div class="grid">{xs.map(x=><article class="card"><span class="badge">{x.data.status.replaceAll('-',' ')}</span><h3><a href={`${base}georgien/sehenswuerdigkeiten/${x.data.slug}/`}>{x.data.title}</a></h3><p>{x.data.summary}</p></article>)}</div></section>})}<aside class="alert"><strong>Nicht als Ausflugsziele:</strong> Abchasien und Südossetien liegen ausserhalb der Kontrolle der georgischen Regierung. Aktuelle Reisehinweise und die politische Lage sind verbindlich vor jeder Planung zu prüfen.</aside></div></Base>
