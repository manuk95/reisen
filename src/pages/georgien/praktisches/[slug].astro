import {getCollection} from 'astro:content';export async function getStaticPaths(){return (await getCollection('praktisches')).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}const {entry}=Astro.props;const base=import.meta.env.BASE_URL;const target=entry.data.slug==='packliste'?`${base}georgien/wissen/packliste/`:`${base}georgien/wissen/praktisches/#${entry.data.slug}`;return Astro.redirect(target, 301);
