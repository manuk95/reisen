---
import Base from '../../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('reisetage')).map(d=>({params:{slug:d.data.slug},props:{d}}))}
const {d}=Astro.props;const days=(await getCollection('reisetage')).sort((a,b)=>a.data.day-b.data.day);const prev=days[d.data.day-2],next=days[d.data.day];const {Content}=await render(d);const base=import.meta.env.BASE_URL;
const [hotels,orte,attr,genuss,restaurants]=await Promise.all(['unterkuenfte','orte','sehenswuerdigkeiten','genuss','restaurants'].map((c:any)=>getCollection(c)));
const byDay=(xs:any[])=>xs.filter(x=>x.data.days.includes(d.data.slug)); const dayHotels=byDay(hotels),dayRestaurants=byDay(restaurants);
const all=[...orte,...attr,...hotels,...genuss,...restaurants];
const linkLabel=(text:string)=>{let out=text;all.sort((a:any,b:any)=>b.data.title.length-a.data.title.length).forEach((x:any)=>{const title=x.data.title;if(out.includes(title)){const sec=x.collection==='unterkuenfte'?'hotels':x.collection;out=out.replaceAll(title,`<a href="${base}georgien/${sec}/${x.data.slug}/">${title}</a>`)}});return out};
const events=[...d.data.fixed.map((x:any)=>({...x,fixed:true})),...d.data.recommended.map((x:any)=>({...x,fixed:false}))].sort((a,b)=>a.time.localeCompare(b.time));
const facts=[['Klima',d.data.climate],['Distanz',d.data.distance||'–'],['Fahrzeit',d.data.driveTime||'–'],['Baden',d.data.bathing],['Sonnenaufgang',d.data.sunrise||'–'],['Sonnenuntergang',d.data.sunset||'–']];
---
<Base title={d.data.title}><div class="wrap"><p><a href={`${base}georgien/`}>Georgien</a> / <a href={`${base}georgien/reiseplan/`}>Reiseplan</a> / Tag {d.data.day}</p><p class="eyebrow">{d.data.date.toLocaleDateString('de-CH',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</p><h1>{d.data.from} → {d.data.to}</h1><p class="lead">{d.data.character}</p>
<div class="day-facts">{facts.map(([label,value])=><section><h2>{label}</h2><p>{value}</p></section>)}</div>
<section><h2>Chronologischer Tagesablauf</h2><ol class="timeline card">{events.map(x=><li><time>{x.time}</time><span><span set:html={linkLabel(x.label)} /> {x.fixed&&<small class="badge fix">Fix</small>}</span></li>)}</ol></section>
{d.data.optional.length>0&&<section><h2>Optionen und Alternativen</h2><ul>{d.data.optional.map(x=><li set:html={linkLabel(x)} />)}</ul></section>}
<section><h2>Restaurant- und Essensvorschläge</h2>{dayRestaurants.length?<div class="grid">{dayRestaurants.map((x:any)=><article class="card"><h3><a href={`${base}georgien/restaurants/${x.data.slug}/`}>{x.data.title}</a></h3><p>{x.data.summary}</p><p class="meta">{x.data.region} · konkrete Preise und Reservierung vorab prüfen</p><a href={x.data.sources[0].url} target="_blank" rel="noopener noreferrer">Quelle / Kartenposition</a></article>)}</div>:<p>Für diesen Tag nennt die Reiseplanung keinen zuverlässig belegten einzelnen Betrieb. Mahlzeiten stehen im Ablauf; vor Ort nach aktueller Öffnung auswählen.</p>}</section>
<section><h2>Hotelvorschläge</h2>{dayHotels.length?<div class="grid">{dayHotels.map((h:any)=><article class="card"><span class="badge">{h.data.status}</span><h3><a href={`${base}georgien/hotels/${h.data.slug}/`}>{h.data.title}</a></h3><p>{h.data.summary}</p><p class="meta">{h.data.region} · Preis, Verfügbarkeit, Parkplatz und Frühstück vor Buchung prüfen.</p><a href={h.data.sources[0].url} target="_blank" rel="noopener noreferrer">Konkrete Hotelquelle</a></article>)}</div>:<p>Keine Übernachtung beziehungsweise noch kein konkreter Vorschlag für diesen Tag.</p>}</section>
<article class="prose"><h2>Praktische Hinweise</h2><Content /></article><aside class="alert"><strong>Unterkunft:</strong> {d.data.lodging || 'noch offen'} – Vorschläge sind keine Buchungsbestätigung.</aside><div class="actions">{prev&&<a class="secondary" href={`${base}georgien/tag/${prev.data.slug}/`}>← Tag {prev.data.day}</a>}{next&&<a href={`${base}georgien/tag/${next.data.slug}/`}>Tag {next.data.day} →</a>}</div></div></Base>
