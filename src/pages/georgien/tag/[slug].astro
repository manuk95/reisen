---
import Base from '../../../layouts/Base.astro';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('reisetage')).map(d=>({params:{slug:d.data.slug},props:{d}}))}
const {d}=Astro.props;const days=(await getCollection('reisetage')).sort((a,b)=>a.data.day-b.data.day);const prev=days[d.data.day-2],next=days[d.data.day];const {Content}=await render(d);const base=import.meta.env.BASE_URL;
const [hotels,orte,attr,genuss,restaurants]=await Promise.all(['unterkuenfte','orte','sehenswuerdigkeiten','genuss','restaurants'].map((c:any)=>getCollection(c)));
const byDay=(xs:any[])=>xs.filter(x=>x.data.days.includes(d.data.slug));
const dayHotels=byDay(hotels), dayPlaces=byDay(orte), dayAttr=byDay(attr), dayFood=[...byDay(genuss),...byDay(restaurants)];
const linkLabel=(text:string)=>{let out=text;[...orte,...attr,...hotels,...genuss,...restaurants].forEach((x:any)=>{if(out.includes(x.data.title)){const sec=x.collection==='unterkuenfte'?'hotels':x.collection;out=out.replaceAll(x.data.title,`<a href="${base}georgien/${sec}/${x.data.slug}/">${x.data.title}</a>`)}});return out};
---
<Base title={d.data.title}><div class="wrap"><p><a href={`${base}georgien/`}>Georgien</a> / <a href={`${base}georgien/reiseplan/`}>Reiseplan</a> / Tag {d.data.day}</p><p class="eyebrow">{d.data.date.toLocaleDateString('de-CH',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</p><h1>{d.data.from} → {d.data.to}</h1><p class="meta">{d.data.character} {d.data.distance&&`· ${d.data.distance}`} {d.data.driveTime&&`· ${d.data.driveTime}`}</p><div class="grid"><section class="card"><span class="badge fix">Fix</span><h2>Fixe Termine</h2>{d.data.fixed.length?<ol class="timeline">{d.data.fixed.map(x=><li><time>{x.time}</time><strong set:html={linkLabel(x.label)} /></li>)}</ol>:<p>Heute gibt es keine fix gebuchte Uhrzeit.</p>}</section><section class="card"><span class="badge">Empfohlen</span><h2>Tagesablauf</h2><ol class="timeline">{d.data.recommended.map(x=><li><time>{x.time}</time><span set:html={linkLabel(x.label)} /></li>)}</ol></section></div>{dayHotels.length>0&&<section><h2>Passende Hotelempfehlungen</h2><div class="grid">{dayHotels.map((h:any)=><article class="card"><span class="badge">{h.data.status}</span><h3><a href={`${base}georgien/hotels/${h.data.slug}/`}>{h.data.title}</a></h3><p>{h.data.summary}</p><p class="meta">{h.data.region} · Preis/Bewertung Stand {h.data.updated.toLocaleDateString('de-CH')} vor Buchung prüfen.</p>{h.data.sources[0]&&<a class="button" href={h.data.sources[0].url} target="_blank" rel="noopener noreferrer">Konkrete Anbieter-/Infoseite öffnen</a>}</article>)}</div></section>}<section class="card"><h2>Verknüpfte Inhalte des Tages</h2><p><strong>Orte:</strong> {dayPlaces.length?dayPlaces.map((x:any)=><><a href={`${base}georgien/orte/${x.data.slug}/`}>{x.data.title}</a>{' '}</>):'keine spezifischen Ortsseiten'}</p><p><strong>Attraktionen:</strong> {dayAttr.length?dayAttr.map((x:any)=><><a href={`${base}georgien/sehenswuerdigkeiten/${x.data.slug}/`}>{x.data.title}</a>{' '}</>):'keine spezifischen Attraktionen'}</p><p><strong>Essen & Restaurants:</strong> {dayFood.length?dayFood.map((x:any)=><><a href={`${base}georgien/${x.collection==='genuss'?'genuss':'restaurants'}/${x.data.slug}/`}>{x.data.title}</a>{' '}</>):'spontan entlang der Route planen'}</p></section>{d.data.optional.length>0&&<section><h2>Optional</h2><ul>{d.data.optional.map(x=><li>{x}</li>)}</ul></section>}<article class="prose"><Content /></article><aside class="alert"><strong>Unterkunft:</strong> {d.data.lodging || 'noch offen'} · Vorschläge oben; noch nicht als Buchung veröffentlichen.</aside><div class="actions">{prev&&<a class="secondary" href={`${base}georgien/tag/${prev.data.slug}/`}>← Tag {prev.data.day}</a>}{next&&<a href={`${base}georgien/tag/${next.data.slug}/`}>Tag {next.data.day} →</a>}</div></div></Base>
