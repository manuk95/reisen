---
import Base from '../../../layouts/Base.astro';import {getCollection} from 'astro:content';export async function getStaticPaths(){return (await getCollection('reisetage')).map(d=>({params:{slug:d.data.slug},props:{d}}))}const {d}=Astro.props;const days=(await getCollection('reisetage')).sort((a,b)=>a.data.day-b.data.day);const prev=days[d.data.day-2],next=days[d.data.day];const {Content}=await d.render();const base=import.meta.env.BASE_URL;
---
<Base title={d.data.title}><div class="wrap"><p><a href={`${base}georgien/`}>Georgien</a> / <a href={`${base}georgien/reiseplan/`}>Reiseplan</a> / Tag {d.data.day}</p><p class="eyebrow">{d.data.date.toLocaleDateString('de-CH',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</p><h1>{d.data.from} → {d.data.to}</h1><p class="meta">{d.data.character} {d.data.distance&&`· ${d.data.distance}`} {d.data.driveTime&&`· ${d.data.driveTime}`}</p><div class="grid"><section class="card"><span class="badge fix">Fix</span><h2>Fixe Termine</h2>{d.data.fixed.length?<ol class="timeline">{d.data.fixed.map(x=><li><time>{x.time}</time><strong>{x.label}</strong></li>)}</ol>:<p>Heute gibt es keine fix gebuchte Uhrzeit.</p>}</section><section class="card"><span class="badge">Empfohlen</span><h2>Tagesablauf</h2><ol class="timeline">{d.data.recommended.map(x=><li><time>{x.time}</time><span>{x.label}</span></li>)}</ol></section></div>{d.data.optional.length>0&&<section><h2>Optional</h2><ul>{d.data.optional.map(x=><li>{x}</li>)}</ul></section>}<article class="prose"><Content /></article><aside class="alert"><strong>Unterkunft:</strong> {d.data.lodging} · Vorschlag, noch zu buchen.</aside><div class="actions">{prev&&<a class="secondary" href={`${base}georgien/tag/${prev.data.slug}/`}>← Tag {prev.data.day}</a>}{next&&<a href={`${base}georgien/tag/${next.data.slug}/`}>Tag {next.data.day} →</a>}</div></div></Base>
