---
import Base from '../layouts/Base.astro';import {getCollection} from 'astro:content';const trips=await getCollection('reisen');const base=import.meta.env.BASE_URL;
---
<Base title="Unsere Reisen"><section class="wrap"><div><p class="eyebrow">Persönlich · sorgfältig · offline dabei</p><h1>Unsere Reisen</h1><p>Reisepläne, Orte und Geschichten für unterwegs. Von Manuel und Martina – ohne Tracking und mit Raum für kommende Reisen.</p></div></section><section class="wrap"><p class="eyebrow">Unsere Reisen</p><div class="grid">{trips.map(t=><article class="card"><span class="badge fix">Geplant</span><h2>{t.data.title}</h2><p>{t.data.summary}</p><p class="meta">28. September – 11. Oktober 2026 · 14 Tage</p><p>{t.data.route.join(' · ')}</p><div class="actions"><a href={`${base}georgien/`}>Reiseführer</a><a class="secondary" href={`${base}georgien/reiseplan/`}>Reiseplan</a><a class="secondary" href={`${base}georgien/karte/`}>Karte</a></div></article>)}</div><aside class="alert"><strong>Weitere Reisen</strong><br>Die Sammlung wächst mit jeder neuen Reise. Noch gibt es bewusst keine erfundenen Ziele.</aside></section></Base>
