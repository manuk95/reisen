---
import '../styles/global.css';
import { footerNavigation, mainNavigation, mobileNavigation } from '../data/site-pages';
const { title = 'Reisen', description = 'Persönliche Reiseführer von Manuel und Martina' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173f35" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icons/icon.svg`} />
    <title>{title} · Unsere Reisen</title>
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <div id="offline" role="status" hidden>Offline – Reisewissen bleibt verfügbar, die Karte benötigt Internet.</div>
    <header>
      <a class="brand" href={base}>Manuel & Martina <small>unterwegs</small></a>
      <button id="menuToggle" class="menu-toggle" aria-controls="mainMenu" aria-expanded="false"><span>☰</span> Menü</button>
      <button id="theme" aria-label="Farbschema wechseln">◐</button>
    </header>
    <div id="scrim" hidden></div>
    <nav id="mainMenu" class="drawer" aria-label="Hauptmenü" hidden>
      <div class="drawer-head"><strong>Reiseführer Georgien 2026</strong><button id="menuClose" aria-label="Menü schliessen">×</button></div>
      {mainNavigation.map((group) => group.items ? (
        <details open={group.label === 'Entdecken'}>
          <summary>{group.label}</summary>
          {group.items.map((item) => <a class:list={{ active: Astro.url.pathname === `${base}${item.path}` }} href={`${base}${item.path}`}>{item.label}</a>)}
        </details>
      ) : <a class:list={{ active: Astro.url.pathname === `${base}${group.path}` }} href={`${base}${group.path}`}>{group.label}</a>)}
    </nav>
    <main id="inhalt"><slot /></main>
    <nav class="bottom" aria-label="Mobile Quicklinks">{mobileNavigation.map((item) => <a href={`${base}${item.path}`}>{item.label}</a>)}</nav>
    <footer>
      <div class="footer-grid">{footerNavigation.map((group) => <section><h2>{group.label}</h2>{group.items.map((item) => <a href={`${base}${item.path}`}>{item.label}</a>)}</section>)}</div>
      <section id="pwa-update" class="pwa-update" data-base={base} aria-labelledby="pwa-update-title">
        <h2 id="pwa-update-title">Website-Version</h2>
        <p><span data-update-status role="status" aria-live="polite">Prüfe auf Aktualisierung …</span></p>
        <button class="button" type="button" data-update-button hidden>Aktualisieren</button>
      </section>
      <p>Persönlicher Reiseführer · ohne Tracking. Stand redaktioneller Angaben: 6. August 2026; zeitabhängige Angaben vor Ort erneut prüfen.</p>
    </footer>
    <script is:inline type="module" src={`${base}pwa-update.js`}></script>
    <script is:inline define:vars={{base}}>
      const root=document.documentElement,saved=localStorage.getItem('theme');if(saved)root.dataset.theme=saved;
      document.querySelector('#theme')?.addEventListener('click',()=>{const n=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=n;localStorage.setItem('theme',n)});
      const offline=document.querySelector('#offline');function network(){offline.hidden=navigator.onLine}addEventListener('online',network);addEventListener('offline',network);network();
      const t=document.querySelector('#menuToggle'),m=document.querySelector('#mainMenu'),c=document.querySelector('#menuClose'),s=document.querySelector('#scrim');
      function openMenu(){m.hidden=false;s.hidden=false;t.setAttribute('aria-expanded','true');c.focus()}
      function closeMenu(){m.hidden=true;s.hidden=true;t.setAttribute('aria-expanded','false');t.focus()}
      t.addEventListener('click',()=>m.hidden?openMenu():closeMenu());c.addEventListener('click',closeMenu);s.addEventListener('click',closeMenu);addEventListener('keydown',e=>{if(e.key==='Escape'&&!m.hidden)closeMenu()});
    </script>
  </body>
</html>
