---
import '../styles/global.css';
const {title='Reisen',description='Persönliche Reiseführer von Manuel und Martina'}=Astro.props;
const base=import.meta.env.BASE_URL;
const nav=[['Übersicht','georgien/'],['Heute','georgien/heute/'],['Plan','georgien/reiseplan/'],['Karte','georgien/karte/'],['Orte','georgien/orte/'],['Genuss','georgien/genuss/'],['Hotels','georgien/hotels/'],['Wissen','georgien/wissen/'],['Praktisch','georgien/praktisches/'],['Suche','suche/']];
const url=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="theme-color" content="#173f35"><meta name="description" content={description}><link rel="canonical" href={url}><link rel="manifest" href={`${base}manifest.webmanifest`}><link rel="icon" href={`${base}icons/icon.svg`}><title>{title} · Unsere Reisen</title></head>
<body><a class="skip" href="#inhalt">Zum Inhalt springen</a><div id="offline" role="status" hidden>Offline – Reisewissen bleibt verfügbar, die Karte benötigt Internet.</div><header><a class="brand" href={base}>Manuel & Martina <small>unterwegs</small></a><nav aria-label="Hauptnavigation">{nav.map(([n,p])=><a href={`${base}${p}`}>{n}</a>)}</nav><button id="theme" aria-label="Farbschema wechseln">◐</button></header><main id="inhalt"><slot /></main><nav class="bottom" aria-label="Mobile Navigation">{nav.slice(0,5).map(([n,p])=><a href={`${base}${p}`}>{n}</a>)}</nav><footer><p>Persönlicher Reiseführer · ohne Tracking · <a href={`${base}bildnachweis/`}>Bildnachweis</a></p><p>Stand redaktioneller Angaben: 3. August 2026. Zeitabhängige Angaben vor Ort prüfen.</p></footer>
<script is:inline define:vars={{base}}>
const root=document.documentElement, saved=localStorage.getItem('theme'); if(saved) root.dataset.theme=saved;
document.querySelector('#theme')?.addEventListener('click',()=>{const n=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=n;localStorage.setItem('theme',n)});
const offline=document.querySelector('#offline');function network(){offline.hidden=navigator.onLine}addEventListener('online',network);addEventListener('offline',network);network();
if('serviceWorker' in navigator) navigator.serviceWorker.register(base+'sw.js',{scope:base});
</script></body></html>
